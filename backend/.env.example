# Backend environment configuration
# Copy this file to ".env" and fill in real values.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
FRONTEND_ORIGIN=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Docker default:
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/realestate_ai
# Optional discrete PG vars (used if DATABASE_URL missing)
PGHOST=postgres
PGPORT=5432
PGDATABASE=realestate_ai
PGUSER=user
PGPASSWORD=pass
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
CONVERSATION_MODEL=llama-3.3-70b-versatile
COMPLIANCE_MODEL=llama-3.3-70b-versatile
INTENT_MODEL=llama-3.3-70b-versatile
SCORING_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# LangChain / tracing
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# -----------------------------------------------------------------------------
# Google Sheets integration
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=your-sheet-id
GOOGLE_SHEETS_SPREADSHEET_ID=your-sheet-id
GOOGLE_SHEETS_SHEET_NAME=HotLeads

# -----------------------------------------------------------------------------
# Market data APIs
# -----------------------------------------------------------------------------
FRED_API_KEY=your-fred-key
CENSUS_API_KEY=your-census-key
CENSUS_ACS_YEAR=2022
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=LeadIntelBot/1.0
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
TWITTER_BEARER_TOKEN=
CLAY_API_KEY=
CLAY_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SENDGRID_API_KEY=
NOTIFICATION_EMAIL=
FRONTEND_BASE_URL=http://localhost:3001
DEALS_DEFAULT_CITIES=Austin,Miami,New York Metro
FORECLOSURE_DEFAULT_STATES=NJ,TX,FL,CA
FORECLOSURE_RSS_FEEDS=

# -----------------------------------------------------------------------------
# Scoring weights
# -----------------------------------------------------------------------------
SCORING_WEIGHT_TIMELINE=0.30
SCORING_WEIGHT_BUDGET=0.20
SCORING_WEIGHT_LOCATION=0.10
SCORING_WEIGHT_PREAPPROVAL=0.10
SCORING_WEIGHT_INTENT_CONFIDENCE=0.10
SCORING_WEIGHT_ENGAGEMENT=0.10
SCORING_WEIGHT_CONSENT_CONTACT=0.10

